{
  "name": "@kizenapps/cli",
  "version": "1.6.1",
  "description": "CLI tool for running Kizen plugin apps locally",
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "appbuilder": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:cli && pnpm run build:viewer",
    "build:cli": "tsup",
    "watch": "concurrently -n cli,viewer -c cyan,magenta \"tsup --watch\" \"vite build --watch --config viewer/vite.config.ts\"",
    "build:viewer": "vite build --config viewer/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p viewer/tsconfig.json",
    "lint": "eslint src viewer/src",
    "lint:fix": "eslint src viewer/src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "appbuilder",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint && pnpm run build",
    "version:prerelease": "node scripts/version-prerelease.js",
    "version:check": "node scripts/version-release.js"
  },
  "dependencies": {
    "@kizenapps/engine": "^1.6.0",
    "@kizenapps/packager": "0.2.0",
    "chrome-launcher": "^1.2.1",
    "chrome-remote-interface": "^0.34.0",
    "commander": "^14.0.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.3",
    "ink": "^7.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/pro-light-svg-icons": "^7.2.0",
    "@fortawesome/pro-regular-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.168.22",
    "@types/hast": "^3.0.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "highlight.js": "^11.11.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8"
  }
}
